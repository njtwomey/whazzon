# Dependencies
node_modules/

# Build output
dist/
*.tsbuildinfo

# Generated copies of committed data.
#
# `sync-web` copies data/<location>/snapshot.json and data/<location>/assets/*
# into the web app so vite can serve them. The originals under data/ are the
# real thing and ARE committed — these are duplicates, regenerated by
# `make sync` and removed by `make clean`.
web/public/snapshots/
web/public/assets/

# Test and coverage output
coverage/
.vitest/

# Editor and OS
.DS_Store
.idea/
.vscode/
*.swp

# Logs
*.log
npm-debug.log*

# Per-machine Claude Code settings. .claude/settings.json and .claude/skills/
# ARE committed — the harvest skill is part of the project.
.claude/settings.local.json

# Scratch space for notes-in-progress, not part of the project.
.scratch/

# Secrets
.env
.env.*
!.env.example

# NOTE: data/ is deliberately NOT ignored. The catalogue, the harvest log and
# the compiled snapshot are the project — the deployed site is a static
# reflection of what is committed here.
